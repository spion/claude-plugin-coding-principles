{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "cat", "args": ["${CLAUDE_PLUGIN_ROOT}/instructions.md"] }]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq",
            "args": [
              "-Rs",
              "{hookSpecificOutput: {hookEventName: \"SubagentStart\", additionalContext: .}}",
              "${CLAUDE_PLUGIN_ROOT}/instructions.md"
            ]
          }
        ]
      }
    ]
  }
}
